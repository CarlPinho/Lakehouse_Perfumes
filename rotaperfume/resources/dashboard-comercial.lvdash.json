{
  "datasets": [
    {
      "name": "ds_fato_vendas",
      "displayName": "Fato Vendas",
      "queryLines": [
        "SELECT item_id, pedido_id, data_pedido, ano, mes, canal, ",
        "cliente_id, razao_social, segmento, cidade, vendedor_id, ",
        "sku, categoria, marca, ",
        "receita AS receita_item, custo AS custo_item, margem AS margem_item ",
        "FROM fato_vendas\n"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Faturamento líquido total em R$",
          "expression": "SUM(`receita_item`)"
        },
        {
          "displayName": "Margem",
          "description": "Margem de contribuição total em R$",
          "expression": "SUM(`margem_item`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Quantidade total de pedidos únicos",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio",
          "description": "Faturamento médio por pedido em R$",
          "expression": "SUM(`receita_item`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem %",
          "description": "Percentual da margem sobre a receita",
          "expression": "SUM(`margem_item`) / SUM(`receita_item`)"
        }
      ]
    },
    {
      "name": "ds_fila_semanal",
      "displayName": "Fila Semanal",
      "queryLines": [
        "SELECT vendedor, ordem, cliente_id, razao_social, cidade, uf, ",
        "score, faixa, ticket_medio, motivo, sugestao ",
        "FROM fila_semanal\n"
      ],
      "columns": [
        {
          "displayName": "Total Clientes",
          "description": "Total de contatos na fila semanal",
          "expression": "COUNT(*)"
        },
        {
          "displayName": "Receita Esperada",
          "description": "Receita potencial calculada pelo modelo: SUM(score * ticket_medio)",
          "expression": "SUM(`score` * `ticket_medio`)"
        },
        {
          "displayName": "Ticket Médio Fila",
          "description": "Ticket médio médio dos clientes selecionados",
          "expression": "AVG(`ticket_medio`)"
        },
        {
          "displayName": "Vendedores Alocados",
          "description": "Total de vendedores com carteira na fila",
          "expression": "COUNT(DISTINCT `vendedor`)"
        }
      ]
    }
  ],

